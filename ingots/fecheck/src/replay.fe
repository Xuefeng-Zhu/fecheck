// Deterministic replay of saved cases.
//
// Replay feeds a case's recorded choices back into the test. It never uses
// the PRNG, so the result depends only on the choices and the code under
// test. For state-machine tests the regenerated commands are compared with
// the recorded `op` lines first: if the generator or model changed so that
// the same choices now mean different commands, replay reports drift instead
// of silently testing something else.
//
// The comparison covers the whole recorded trace: the replay must
// regenerate exactly the recorded number of operations, each verbatim, and
// read every recorded choice. A case file with an operation removed,
// or a replay that would run past the recorded trace, is drift, never a
// reproduction. State-machine cases replay with the generation settings
// they were found with (`steps` in the file), not the caller's.

use core::{MemBuffer, MemVec}
use super::source::{Source, copy_choices, DEFAULT_MAX_CHOICES}
use super::verdict::Verdict
use super::artifact::{Case, LEGACY_STEPS_MAX, LEGACY_STEPS_MEAN}
use super::machine::{
    StateMachine,
    EffectfulMachine,
    Steps,
    Trace,
    run_traced,
    run_traced_with,
    steps as make_steps,
    NO_STEP,
}

pub enum ReplayOutcome {
    /// The recorded failure happened again, at the same step.
    Reproduced,
    /// The case now passes: the bug is fixed (or the test got weaker).
    NoLongerFails,
    /// The case still fails, but differently (other kind, code or step).
    DifferentFailure {
        pub verdict: Verdict,
        pub step: u64,
    },
    /// The case was discarded or overran its budget: the generator changed.
    Invalid,
    /// The regenerated commands differ from the recorded ones at `step`.
    Drift { pub step: u64 },
}

impl Copy for ReplayOutcome {}

impl ReplayOutcome {
    /// 0 reproduced, 1 no longer fails, 2 different failure, 3 invalid, 4 drift.
    pub fn kind(self) -> u64 {
        match self {
            ReplayOutcome::Reproduced => 0,
            ReplayOutcome::NoLongerFails => 1,
            ReplayOutcome::DifferentFailure { verdict, step } => 2,
            ReplayOutcome::Invalid => 3,
            ReplayOutcome::Drift { step } => 4,
        }
    }

    pub fn is_reproduced(self) -> bool {
        self.kind() == 0
    }
}

/// Replays a property-test case.
pub fn replay_property<F: Fn(mut Source) -> Verdict>(_ test: F, _ case: Case) -> ReplayOutcome
uses F::E
{
    var src = Source::replay(copy_choices(case.choices), DEFAULT_MAX_CHOICES)
    let v = test(mut src)
    // A clamped choice means the file or the generator changed.
    if src.clamped() != 0 {
        return ReplayOutcome::Drift { step: NO_STEP }
    }
    // A reproduction must read exactly the recorded choices: none left over
    // (a property that reads fewer, or none, is not the recorded run) and
    // none supplied past the end (a file missing its last choices).
    if v.is_failure() && (src.unread() != 0 || src.past_end() != 0) {
        return ReplayOutcome::Drift { step: NO_STEP }
    }
    classify(v, src.overran(), NO_STEP, case)
}

/// The `op` line for a step: its command, marked when the precondition
/// skipped it (schema 3), so replay can tell a skipped command from an
/// executed one.
pub fn op_text(_ command: MemBuffer, _ skipped: bool) -> MemBuffer {
    if skipped {
        format!(SKIPPED_PREFIX, command)
    } else {
        format!(command)
    }
}

/// The prefix of a skipped step's `op` line.
pub const SKIPPED_PREFIX: String<10> = "(skipped) "

/// Checks a regenerated trace against the case before it is classified.
/// Returns `Some(drift)` when they disagree.
fn trace_drift(
    _ case: Case,
    _ trace: Trace,
    _ clamped: u64,
    _ past_end: u64,
    _ unread: usize,
    _ overran: bool,
) -> Option<ReplayOutcome> {
    if clamped != 0 {
        return Option::Some(ReplayOutcome::Drift { step: 0 })
    }
    // Every recorded op must be regenerated, in order and verbatim, and
    // nothing more: the regenerated trace has exactly the recorded length.
    // Schema 3 also records which steps the precondition skipped.
    var i: usize = 0
    while i < case.ops.len() {
        if i >= trace.steps.len() {
            return Option::Some(ReplayOutcome::Drift { step: i.downcast_saturate() })
        }
        let skipped = case.schema >= 3 && trace.steps[i].skipped
        if op_text(format!(trace.steps[i].command), skipped) != case.ops[i] {
            return Option::Some(ReplayOutcome::Drift { step: i.downcast_saturate() })
        }
        i += 1
    }
    if trace.steps.len() != case.ops.len() {
        return Option::Some(
            ReplayOutcome::Drift { step: case.ops.len().downcast_saturate() },
        )
    }
    // Every recorded choice must be read: unread choices mean the file and
    // the generator disagree. (Reads past the end return 0, which stops the
    // sequence; a fixed target that passes the last recorded operation makes
    // exactly one such read, so past-end reads only disqualify a failure.)
    if !overran && unread != 0 {
        return Option::Some(
            ReplayOutcome::Drift { step: case.ops.len().downcast_saturate() },
        )
    }
    if !trace.verdict.is_pass() && past_end != 0 {
        return Option::Some(
            ReplayOutcome::Drift { step: case.ops.len().downcast_saturate() },
        )
    }
    Option::None
}

/// The generation settings to replay `case` with: the recorded ones, or the
/// 0.1.0 defaults for a schema-1 file that did not record them.
pub fn case_steps(_ case: Case) -> Steps {
    if case.has_steps {
        make_steps(case.steps_max, case.steps_mean)
    } else {
        make_steps(LEGACY_STEPS_MAX, LEGACY_STEPS_MEAN)
    }
}

/// Replays a state-machine case. Returns the outcome and the full trace.
///
/// `fallback` is used only for a case that recorded no generation settings
/// (schema 1) and that has no `steps` of its own; a case that recorded them
/// always replays with its own, whatever `fallback` says.
pub fn replay_machine<M: StateMachine>(_ machine: M, _ fallback: Steps, _ case: Case) -> (
    ReplayOutcome,
    Trace,
) {
    let s = if case.has_steps {
        case_steps(case)
    } else {
        fallback
    }
    var src = Source::replay(copy_choices(case.choices), DEFAULT_MAX_CHOICES)
    let trace = run_traced(machine, mut src, s)
    match trace_drift(
        case,
        trace,
        src.clamped(),
        src.past_end(),
        src.unread(),
        src.overran(),
    ) {
        Option::Some(d) => {
            return (d, trace)
        },
        Option::None => {},
    }
    let outcome = classify(trace.verdict, src.overran(), trace.failed_step, case)
    (outcome, trace)
}

/// `replay_machine` for an `EffectfulMachine`: the same checks, with the
/// test's effect (for example the `fe test` EVM) supplied to the machine. A
/// case found by a pure machine replays here against a deployed contract when
/// the two machines generate the same commands.
pub fn replay_machine_with<M: EffectfulMachine>(_ machine: M, _ fallback: Steps, _ case: Case) -> (
    ReplayOutcome,
    Trace,
)
uses (env: mut M::Env)
{
    let s = if case.has_steps {
        case_steps(case)
    } else {
        fallback
    }
    var src = Source::replay(copy_choices(case.choices), DEFAULT_MAX_CHOICES)
    let trace = run_traced_with(machine, mut src, s)
    match trace_drift(
        case,
        trace,
        src.clamped(),
        src.past_end(),
        src.unread(),
        src.overran(),
    ) {
        Option::Some(d) => {
            return (d, trace)
        },
        Option::None => {},
    }
    let outcome = classify(trace.verdict, src.overran(), trace.failed_step, case)
    (outcome, trace)
}

fn classify(_ v: Verdict, _ overran: bool, _ step: u64, _ case: Case) -> ReplayOutcome {
    if overran || v.is_discard() {
        return ReplayOutcome::Invalid
    }
    if v.is_pass() {
        return ReplayOutcome::NoLongerFails
    }
    let expected_step = if case.has_failed_step {
        case.failed_step
    } else {
        NO_STEP
    }
    if v.same_failure(case.verdict) && step == expected_step {
        return ReplayOutcome::Reproduced
    }
    ReplayOutcome::DifferentFailure { verdict: v, step }
}

/// Builds the case file for a failure found by `check` on a state machine.
/// `trace` is the traced run of the shrunk choices.
pub fn machine_case(
    test: own MemBuffer,
    target: own MemBuffer,
    compiler: own MemBuffer,
    seed: u64,
    case_index: u64,
    cases: u64,
    steps: Steps,
    original_length: u64,
    _ choices: MemVec<u64>,
    _ trace: Trace,
) -> Case {
    var ops: MemVec<MemBuffer> = MemVec::new()
    for ref step in trace.steps {
        ops.push(op_text(format!(step.command), step.skipped))
    }
    Case {
        schema: 3,
        test,
        target,
        compiler,
        seed,
        case_index,
        cases,
        has_steps: true,
        steps_max: steps.max,
        steps_mean: steps.mean,
        verdict: trace.verdict,
        failed_step: trace.failed_step,
        has_failed_step: trace.failed_step != NO_STEP,
        original_length,
        choices: copy_choices(choices),
        ops,
        violation: format!(trace.explanation),
    }
}
