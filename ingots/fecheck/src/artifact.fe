// Portable regression artifacts (`.case` files).
//
// A case file records the *actual failing input*: the shrunk choice
// sequence, plus the rendered operations and verdict it produced, so a
// replay can check that the same commands are regenerated and that the same
// failure happens. The seed is kept as provenance only; replay never needs
// it.
//
// Format (schema 4): UTF-8 text, one `key value` pair per line, `#` starts a
// comment line. Keys must appear in this order; `op` repeats.
//
//     fecheck-case 4
//     test <name>
//     target <implementation the failure was found against>
//     compiler <compiler version>
//     fecheck <library version>
//     seed <u64>
//     case <u64>
//     cases <u64>
//     steps <max> <mean>           (or "steps none" for a property)
//     verdict <fail|error> <code>
//     failed-step <u64, or "none">
//     original-length <u64>
//     choices <u64> <u64> ...
//     op <run|skip> "<escaped command>"   (zero or more)
//     violation <one-line explanation>
//     end
//
// Schema 1 files (FeCheck 0.1.0) have no `steps` line. They are still
// read, with `has_steps` false, and replayed with the settings the 0.1.0 CLI
// uses by default (40 operations, mean 12); see `case_steps`.
//
// The parser treats a case file as untrusted input: every line is length
// checked, numbers must fit in a u64, the choice count is bounded, unknown
// or out-of-order keys are rejected, and a truncated file (no `end`) is
// rejected. Replay separately validates the recording against the target.

use core::{MemBuffer, MemSpan, MemVec}
use core::text::parse_uint
use super::verdict::{Verdict, kind_name, verdict_from_parts}
use super::machine::steps as make_steps

pub const SCHEMA_VERSION: u64 = 4
/// The oldest schema this FeCheck still reads.
pub const MIN_SCHEMA_VERSION: u64 = 1
pub const FECHECK_VERSION: String<5> = "0.3.0"
/// Generation settings assumed for schema-1 files, which did not record them.
pub const LEGACY_STEPS_MAX: u64 = 40
pub const LEGACY_STEPS_MEAN: u64 = 12
pub const MAX_CASE_CHOICES: usize = 4096
pub const MAX_CASE_OPS: usize = 4096
pub const MAX_LINE: usize = 7 + 21 * MAX_CASE_CHOICES
pub const MAX_FILE: usize = 4194304

/// A parsed (or to-be-written) regression case.
pub struct Case {
    pub schema: u64,
    pub test: MemBuffer,
    pub target: MemBuffer,
    pub compiler: MemBuffer,
    pub producer: MemBuffer,
    pub seed: u64,
    pub case_index: u64,
    pub cases: u64,
    /// The state-machine generation settings the case was found with.
    /// False for schema-1 files, which did not record them.
    pub has_steps: bool,
    pub steps_max: u64,
    pub steps_mean: u64,
    pub verdict: Verdict,
    pub failed_step: u64,
    pub has_failed_step: bool,
    pub original_length: u64,
    pub choices: MemVec<u64>,
    pub ops: MemVec<MemBuffer>,
    /// Schema 4 stores the precondition result independently of Display.
    pub skipped: MemVec<bool>,
    pub violation: MemBuffer,
}

/// Why a case file was rejected.
pub enum ParseError {
    TooLarge,
    LineTooLong { pub line: u64 },
    MissingHeader,
    UnsupportedSchema { pub found: u64 },
    UnexpectedKey { pub line: u64 },
    MissingKey { pub line: u64 },
    BadNumber { pub line: u64 },
    BadVerdict { pub line: u64 },
    TooManyChoices,
    TooManyOps,
    Truncated,
    TrailingData { pub line: u64 },
    /// The fields parse but contradict each other (see `INCONSISTENT_*`).
    Inconsistent { pub reason: u64 },
}

/// The verdict is `pass` or `discard`: a case file records a failure.
pub const INCONSISTENT_VERDICT: u64 = 1
/// A failed step is recorded but there is no `op` line for it, or `op`
/// lines are recorded without a failed step.
pub const INCONSISTENT_STEP: u64 = 2
/// The recorded generation settings are unusable (`Steps::problem`).
pub const INCONSISTENT_STEPS: u64 = 3

impl ParseError {
    /// A one-line, human-readable reason.
    pub fn describe(self, _ out: mut MemBuffer) {
        match self {
            ParseError::TooLarge => write!(mut out, "file is larger than ", MAX_FILE, " bytes"),
            ParseError::LineTooLong { line } => write!(mut out, "line ", line, " is too long"),
            ParseError::MissingHeader => write!(
                mut out,
                "not a FeCheck case file (missing `fecheck-case` header)",
            ),
            ParseError::UnsupportedSchema { found } => write!(
                mut out,
                "unsupported schema version ",
                found,
                " (this FeCheck reads version ",
                SCHEMA_VERSION,
                ")",
            ),
            ParseError::UnexpectedKey { line } => write!(
                mut out,
                "unexpected or out-of-order key on line ",
                line,
            ),
            ParseError::MissingKey { line } => write!(
                mut out,
                "required key missing at line ",
                line,
            ),
            ParseError::BadNumber { line } => write!(mut out, "invalid number on line ", line),
            ParseError::BadVerdict { line } => write!(mut out, "invalid verdict on line ", line),
            ParseError::TooManyChoices => write!(
                mut out,
                "more than ",
                MAX_CASE_CHOICES,
                " choices",
            ),
            ParseError::TooManyOps => write!(mut out, "more than ", MAX_CASE_OPS, " operations"),
            ParseError::Truncated => write!(mut out, "file is truncated (no `end` line)"),
            ParseError::TrailingData { line } => write!(
                mut out,
                "unexpected data after `end` on line ",
                line,
            ),
            ParseError::Inconsistent { reason } => {
                if reason == INCONSISTENT_VERDICT {
                    write!(
                        mut out,
                        "inconsistent case: the verdict must be `fail` or `error`",
                    )
                } else if reason == INCONSISTENT_STEP {
                    write!(
                        mut out,
                        "inconsistent case: `failed-step` and the `op` lines disagree",
                    )
                } else {
                    write!(mut out, "inconsistent case: unusable `steps` settings")
                }
            },
        }
    }
}

impl Copy for ParseError {}

/// Schema 4 encloses command bytes in quotes to preserve trailing whitespace.
/// Only backslash, newline and carriage return need escaping inside the frame.
fn write_command(_ out: mut MemBuffer, _ command: MemSpan) {
    out.push(b'"')
    for b in command {
        if b == 92 {
            out.push(92)
            out.push(92)
        } else if b == 10 {
            out.push(92)
            out.push(b'n')
        } else if b == 13 {
            out.push(92)
            out.push(b'r')
        } else {
            out.push(b)
        }
    }
    out.push(b'"')
}

fn read_command(_ text: MemSpan) -> Option<MemBuffer> {
    let n = text.len()
    if n < 2 || text[0] != b'"' || text[n - 1] != b'"' {
        return Option::None
    }
    var cmd = MemBuffer::new(0)
    var i: usize = 1
    while i < n - 1 {
        let b = text[i]
        if b == 92 {
            i += 1
            if i >= n - 1 {
                return Option::None
            }
            let escaped = text[i]
            if escaped == b'n' {
                cmd.push(10)
            } else if escaped == b'r' {
                cmd.push(13)
            } else if escaped == 92 {
                cmd.push(92)
            } else {
                return Option::None
            }
        } else {
            cmd.push(b)
        }
        i += 1
    }
    Option::Some(cmd)
}

/// Writes a single-line text field. The format is line-based, so a newline
/// or carriage return inside the value (for example a multi-line
/// `describe_failure`) is written as a space instead of splitting the record.
/// Leading and trailing whitespace is dropped because `decode` trims lines,
/// so the written record re-encodes byte for byte.
fn write_text_line(_ out: mut MemBuffer, _ text: MemSpan) {
    var start: usize = 0
    var end = text.len()
    while start < end && is_space(text[start]) {
        start += 1
    }
    while end > start && is_space(text[end - 1]) {
        end -= 1
    }
    var i = start
    while i < end {
        let b = text[i]
        if b == 10 || b == 13 {
            out.push(b' ')
        } else {
            out.push(b)
        }
        i += 1
    }
    out.push(10)
}

fn is_space(_ b: u8) -> bool {
    b == b' ' || b == 9 || b == 10 || b == 13
}

/// Re-encode using the recorded schema and producer.
pub fn encode(_ case: Case) -> MemBuffer {
    var out = MemBuffer::new(0)
    writeln!(
        mut out,
        "# FeCheck regression case. Replay with: fecheck replay <this file>",
    )
    writeln!(mut out, "fecheck-case ", case.schema)
    write!(mut out, "test ")
    write_text_line(mut out, case.test.span())
    write!(mut out, "target ")
    write_text_line(mut out, case.target.span())
    write!(mut out, "compiler ")
    write_text_line(mut out, case.compiler.span())
    write!(mut out, "fecheck ")
    write_text_line(mut out, case.producer.span())
    writeln!(mut out, "seed ", case.seed)
    writeln!(mut out, "case ", case.case_index)
    writeln!(mut out, "cases ", case.cases)
    if case.has_steps {
        writeln!(mut out, "steps ", case.steps_max, " ", case.steps_mean)
    } else if case.schema >= 4 {
        writeln!(mut out, "steps none")
    }
    writeln!(
        mut out,
        "verdict ",
        kind_name(case.verdict.kind()),
        " ",
        case.verdict.code(),
    )
    if case.has_failed_step {
        writeln!(mut out, "failed-step ", case.failed_step)
    } else {
        writeln!(mut out, "failed-step none")
    }
    writeln!(mut out, "original-length ", case.original_length)
    write!(mut out, "choices")
    for c in case.choices {
        write!(mut out, " ", c)
    }
    writeln!(mut out)
    var i: usize = 0
    for ref op in case.ops {
        if case.schema >= 4 {
            if case.skipped[i] {
                write!(mut out, "op skip ")
            } else {
                write!(mut out, "op run ")
            }
            write_command(mut out, op.span())
            writeln!(mut out)
        } else {
            writeln!(mut out, "op ", op)
        }
        i += 1
    }
    write!(mut out, "violation ")
    write_text_line(mut out, case.violation.span())
    writeln!(mut out, "end")
    out
}

/// The keys of the format, in order. `op` (index 13) may repeat; `steps`
/// (index 8) is absent from schema-1 files.
fn expected_key(_ index: u64) -> String<15> {
    if index == 0 {
        "fecheck-case"
    } else if index == 1 {
        "test"
    } else if index == 2 {
        "target"
    } else if index == 3 {
        "compiler"
    } else if index == 4 {
        "fecheck"
    } else if index == 5 {
        "seed"
    } else if index == 6 {
        "case"
    } else if index == 7 {
        "cases"
    } else if index == 8 {
        "steps"
    } else if index == 9 {
        "verdict"
    } else if index == 10 {
        "failed-step"
    } else if index == 11 {
        "original-length"
    } else if index == 12 {
        "choices"
    } else if index == 13 {
        "op"
    } else if index == 14 { "violation" } else { "end" }
}

/// Parses a decimal u64; `None` on anything else, including overflow.
pub fn parse_u64(_ text: MemSpan) -> Option<u64> {
    if text.len() == 0 || text.len() > 20 {
        return Option::None
    }
    for b in text {
        if b < b'0' || b > b'9' {
            return Option::None
        }
    }
    match parse_uint(text) {
        Option::Some(v) => {
            if v > 0xFFFFFFFFFFFFFFFF {
                Option::None
            } else {
                Option::Some(v.downcast_saturate())
            }
        },
        Option::None => Option::None,
    }
}

fn verdict_kind(_ name: MemSpan) -> Option<u64> {
    if name == "pass" {
        Option::Some(0)
    } else if name == "discard" {
        Option::Some(1)
    } else if name == "fail" {
        Option::Some(2)
    } else if name == "error" {
        Option::Some(3)
    } else {
        Option::None
    }
}

fn empty_case() -> Case {
    Case {
        schema: 0,
        test: MemBuffer::new(0),
        target: MemBuffer::new(0),
        compiler: MemBuffer::new(0),
        producer: MemBuffer::new(0),
        seed: 0,
        case_index: 0,
        cases: 0,
        has_steps: false,
        steps_max: LEGACY_STEPS_MAX,
        steps_mean: LEGACY_STEPS_MEAN,
        verdict: Verdict::Error { code: 0 },
        failed_step: 0,
        has_failed_step: false,
        original_length: 0,
        choices: MemVec::new(),
        ops: MemVec::new(),
        skipped: MemVec::new(),
        violation: MemBuffer::new(0),
    }
}

/// Parses a case file. Never panics on malformed input.
pub fn decode(_ text: MemSpan) -> Result<ParseError, Case> {
    if text.len() > MAX_FILE {
        return Result::Err(ParseError::TooLarge)
    }
    var case = empty_case()
    var key_index: u64 = 0
    var line_no: u64 = 0
    var ended = false
    for line in text.lines() {
        line_no += 1
        if line.len() > MAX_LINE {
            return Result::Err(ParseError::LineTooLong { line: line_no })
        }
        let trimmed = line.trim()
        if trimmed.len() == 0 || trimmed.starts_with(b'#') {
            continue
        }
        if ended {
            return Result::Err(ParseError::TrailingData { line: line_no })
        }
        // Split into `key` and the rest of the line.
        var key_len = trimmed.len()
        var rest_start = trimmed.len()
        match trimmed.index_of(b' ') {
            Option::Some(i) => {
                key_len = i
                rest_start = i + 1
            },
            Option::None => {},
        }
        let key = trimmed.slice(offset: 0, len: key_len)
        let rest = trimmed.slice(offset: rest_start, len: trimmed.len() - rest_start)

        // Schema 1 has no `steps` line.
        if key_index == 8 && (case.schema == 1 || (case.schema < 4 && key == "verdict")) {
            key_index = 9
        }
        // Repeated `op` lines stay at index 13; anything else advances.
        if key_index == 14 && key == "op" {
            key_index = 13
        }
        if key_index > 15 {
            return Result::Err(ParseError::TrailingData { line: line_no })
        }
        // `op` lines are optional: allow skipping straight to `violation`.
        if key_index == 13 && key == "violation" {
            key_index = 14
        }
        if key != expected_key(key_index) {
            if key_index == 0 {
                return Result::Err(ParseError::MissingHeader)
            }
            return Result::Err(ParseError::UnexpectedKey { line: line_no })
        }

        if key_index == 0 {
            match parse_u64(rest) {
                Option::Some(v) => {
                    if v < MIN_SCHEMA_VERSION || v > SCHEMA_VERSION {
                        return Result::Err(ParseError::UnsupportedSchema { found: v })
                    }
                    case.schema = v
                },
                Option::None => {
                    return Result::Err(ParseError::BadNumber { line: line_no })
                },
            }
        } else if key_index == 1 {
            if rest.len() == 0 {
                return Result::Err(ParseError::MissingKey { line: line_no })
            }
            case.test = format!(rest)
        } else if key_index == 2 {
            case.target = format!(rest)
        } else if key_index == 3 {
            case.compiler = format!(rest)
        } else if key_index == 4 {
            case.producer = format!(rest)
        } else if key_index == 5 || key_index == 6 || key_index == 7 || key_index == 11 {
            match parse_u64(rest) {
                Option::Some(v) => {
                    if key_index == 5 {
                        case.seed = v
                    } else if key_index == 6 {
                        case.case_index = v
                    } else if key_index == 7 {
                        case.cases = v
                    } else {
                        case.original_length = v
                    }
                },
                Option::None => {
                    return Result::Err(ParseError::BadNumber { line: line_no })
                },
            }
        } else if key_index == 8 && case.schema >= 4 && rest == "none" {
            case.has_steps = false
        } else if key_index == 8 {
            match rest.index_of(b' ') {
                Option::Some(i) => {
                    let max_text = rest.slice(offset: 0, len: i)
                    let mean_text = rest.slice(offset: i + 1, len: rest.len() - i - 1)
                    match (parse_u64(max_text), parse_u64(mean_text)) {
                        (Option::Some(m), Option::Some(n)) => {
                            case.has_steps = true
                            case.steps_max = m
                            case.steps_mean = n
                        },
                        _ => {
                            return Result::Err(ParseError::BadNumber { line: line_no })
                        },
                    }
                },
                Option::None => {
                    return Result::Err(ParseError::BadNumber { line: line_no })
                },
            }
        } else if key_index == 9 {
            match rest.index_of(b' ') {
                Option::Some(i) => {
                    let name = rest.slice(offset: 0, len: i)
                    let code_text = rest.slice(offset: i + 1, len: rest.len() - i - 1)
                    let kind = match verdict_kind(name) {
                        Option::Some(k) => k,
                        Option::None => {
                            return Result::Err(ParseError::BadVerdict { line: line_no })
                        },
                    }
                    let code = match parse_u64(code_text) {
                        Option::Some(c) => c,
                        Option::None => {
                            return Result::Err(ParseError::BadVerdict { line: line_no })
                        },
                    }
                    case.verdict = verdict_from_parts(kind, code)
                },
                Option::None => {
                    return Result::Err(ParseError::BadVerdict { line: line_no })
                },
            }
        } else if key_index == 10 {
            if rest == "none" {
                case.has_failed_step = false
            } else {
                match parse_u64(rest) {
                    Option::Some(v) => {
                        case.failed_step = v
                        case.has_failed_step = true
                    },
                    Option::None => {
                        return Result::Err(ParseError::BadNumber { line: line_no })
                    },
                }
            }
        } else if key_index == 12 {
            if rest.len() > 0 {
                for field in rest.split(b' ') {
                    if field.len() == 0 {
                        continue
                    }
                    if case.choices.len() >= MAX_CASE_CHOICES {
                        return Result::Err(ParseError::TooManyChoices)
                    }
                    match parse_u64(field) {
                        Option::Some(v) => case.choices.push(v),
                        Option::None => {
                            return Result::Err(ParseError::BadNumber { line: line_no })
                        },
                    }
                }
            }
        } else if key_index == 13 {
            if case.ops.len() >= MAX_CASE_OPS {
                return Result::Err(ParseError::TooManyOps)
            }
            if case.schema >= 4 {
                let skip = rest.starts_with("skip ")
                if !skip && !rest.starts_with("run ") {
                    return Result::Err(ParseError::UnexpectedKey { line: line_no })
                }
                let start: usize = if skip { 5 } else { 4 }
                match read_command(rest.slice(offset: start, len: rest.len() - start)) {
                    Option::Some(cmd) => case.ops.push(cmd),
                    Option::None => {
                        return Result::Err(ParseError::UnexpectedKey { line: line_no })
                    },
                }
                case.skipped.push(skip)
            } else {
                case.ops.push(format!(rest))
            }
        } else if key_index == 14 {
            case.violation = format!(rest)
        } else if key_index == 15 {
            if rest.len() != 0 {
                return Result::Err(ParseError::TrailingData { line: line_no })
            }
            ended = true
        }
        key_index += 1
    }
    if !ended {
        if key_index == 0 {
            return Result::Err(ParseError::MissingHeader)
        }
        return Result::Err(ParseError::Truncated)
    }
    // The fields must describe one coherent failure.
    let kind = case.verdict.kind()
    if kind != 2 && kind != 3 {
        return Result::Err(ParseError::Inconsistent { reason: INCONSISTENT_VERDICT })
    }
    if case.has_failed_step || case.ops.len() != 0 || (case.schema >= 4 && case.has_steps) {
        if !case.valid_machine_failure() {
            return Result::Err(ParseError::Inconsistent { reason: INCONSISTENT_STEP })
        }
        if (case.schema >= 2 && !case.has_steps)
            || (case.has_steps && make_steps(case.steps_max, case.steps_mean).problem() != 0) {
            return Result::Err(ParseError::Inconsistent { reason: INCONSISTENT_STEPS })
        }
    }
    Result::Ok(case)
}

impl Case {
    pub fn valid_machine_failure(self) -> bool {
        let n = self.ops.len()
        if !self.verdict.is_failure()
            || self.choices.len() == 0
            || n == 0
            || !self.has_failed_step
            || self.failed_step != (n - 1).downcast_saturate() {
            return false
        }
        if self.schema >= 4 {
            return self.skipped.len() == n && !self.skipped[n - 1]
        }
        if self.schema == 3 {
            return !self.ops[n - 1].span().starts_with("(skipped) ")
        }
        true
    }
}
