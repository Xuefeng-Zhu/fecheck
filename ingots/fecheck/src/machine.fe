// State-machine testing.
//
// A state-machine test drives a system under test (SUT) with a generated
// sequence of commands and checks it against a simple reference model:
//
// * After every command, `invariant(model, sut)` must hold.
// * After every command, the SUT's observable result must equal the
//   model's (the postcondition). A violated invariant is reported in
//   preference to a mismatch, because it names the broken property.
//
// Every run starts from `new_model()` and `new_sut()`, so each generated
// case, each shrink candidate and each replay begins from the same clean
// state. Commands are generated from the current model state, so a test can
// generate mostly valid commands; `precondition` filters the rest, and a
// command whose precondition fails is skipped (and recorded as skipped) on
// both sides, consistently in generation, shrinking and replay.
//
// The command list is encoded like `VecOf`: a "more" flag before each
// command. Deleting a command's choices removes exactly that command, and
// lowering a flag to 0 truncates the sequence there.

use core::{MemBuffer, MemVec}
use core::ops::Eq
use std::io::Display
use super::source::{Source, continue_odds}
use super::verdict::Verdict

/// Failure code for a command whose SUT result differs from the model's.
pub const POSTCONDITION_MISMATCH: u64 = 0xFFFF0001

/// No step failed.
pub const NO_STEP: u64 = 0xFFFFFFFFFFFFFFFF

/// Error code of a run started with unusable `Steps` (`Steps::problem`).
/// The run executes nothing and reports `Error`, never a vacuous pass.
pub const INVALID_STEPS: u64 = 0xFFFF0002

/// A system under test and the model it is checked against.
pub trait StateMachine {
    /// One operation, such as `Grant(agent=1)`. Display is used in traces.
    type Cmd: Copy + Display
    /// The observable result of applying a command.
    type Obs: Copy + Eq + Display
    /// The reference model's state.
    type Model
    /// The system under test's state.
    type Sut

    fn new_model(self) -> Self::Model
    fn new_sut(self) -> Self::Sut

    /// Draws the next command; may consult the model to prefer valid ones.
    fn gen_cmd(self, _ src: mut Source, _ model: Self::Model) -> Self::Cmd

    /// Whether `cmd` may run in `model`'s state. Rejected commands are skipped.
    fn precondition(self, _ model: Self::Model, _ cmd: Self::Cmd) -> bool

    /// Applies `cmd` to the model and returns the expected observation.
    fn run_model(self, _ model: mut Self::Model, _ cmd: Self::Cmd) -> Self::Obs

    /// Applies `cmd` to the SUT and returns the actual observation.
    fn run_sut(self, _ sut: mut Self::Sut, _ cmd: Self::Cmd) -> Self::Obs

    /// Checked after every executed command. Return `Fail { code }` with a
    /// code that `describe_failure` can explain.
    fn invariant(self, _ model: Self::Model, _ sut: Self::Sut) -> Verdict

    /// Writes a one-line explanation of failure `code` to `out`.
    fn describe_failure(self, _ code: u64, _ out: mut MemBuffer)
}

/// Sequence-length settings for a state-machine test.
pub struct Steps {
    /// The longest command sequence generated.
    pub max: u64,
    /// The mean length in random mode (before `max` cuts it off).
    pub mean: u64,
}

impl Copy for Steps {}

/// The longest command sequence a state-machine test may request.
pub const MAX_STEPS: u64 = 1000
pub const STEPS_NONE: u64 = 1
pub const STEPS_TOO_MANY: u64 = 2
pub const STEPS_NO_MEAN: u64 = 3

impl Steps {
    /// Why these settings are unusable, or 0 when they are valid. A run
    /// with `max == 0` would execute no operations and "pass" vacuously.
    pub fn problem(self) -> u64 {
        if self.max == 0 {
            return STEPS_NONE
        }
        if self.max > MAX_STEPS {
            return STEPS_TOO_MANY
        }
        if self.mean == 0 {
            return STEPS_NO_MEAN
        }
        0
    }
}

pub fn steps(_ max: u64, _ mean: u64) -> Steps {
    Steps { max, mean }
}

/// One executed (or skipped) command of a recorded run.
pub struct Step {
    pub index: u64,
    pub command: MemBuffer,
    pub skipped: bool,
    pub expected: MemBuffer,
    pub actual: MemBuffer,
    pub verdict: Verdict,
}

/// A full record of one state-machine run, for reports and artifacts.
pub struct Trace {
    pub steps: MemVec<Step>,
    pub verdict: Verdict,
    /// Index of the step that failed, or `NO_STEP`.
    pub failed_step: u64,
    /// Commands executed (not skipped).
    pub executed: u64,
    pub skipped: u64,
    /// Explanation of the failure, if any.
    pub explanation: MemBuffer,
    /// First operation whose continuation or operands required repair.
    pub repaired_step: u64,
    /// Choice boundary immediately after the last generated command.
    pub command_end: usize,
}

impl Trace {
    pub fn new() -> Self {
        Trace {
            steps: MemVec::new(),
            verdict: Verdict::Pass,
            failed_step: NO_STEP,
            executed: 0,
            skipped: 0,
            explanation: MemBuffer::new(0),
            repaired_step: NO_STEP,
            command_end: 0,
        }
    }

    /// Number of commands in the sequence, including skipped ones.
    pub fn len(self) -> u64 {
        self.steps.len().downcast_saturate()
    }
}

/// Runs one command sequence drawn from `src`. Returns the verdict.
pub fn run_steps<M: StateMachine>(_ machine: M, _ src: mut Source, _ steps: Steps) -> Verdict {
    var trace = Trace::new()
    execute(machine, mut src, steps, mut trace, false, false)
}

/// Runs one command sequence drawn from `src` and records every step.
pub fn run_traced<M: StateMachine>(_ machine: M, _ src: mut Source, _ steps: Steps) -> Trace {
    var trace = Trace::new()
    let _ = execute(machine, mut src, steps, mut trace, true, false)
    trace
}

pub fn trace_recording<M: StateMachine>(_ machine: M, _ src: mut Source, _ steps: Steps) -> Trace {
    var trace = Trace::new()
    let _ = execute(machine, mut src, steps, mut trace, true, true)
    trace
}

fn execute<M: StateMachine>(
    _ machine: M,
    _ src: mut Source,
    _ steps: Steps,
    _ trace: mut Trace,
    _ record: bool,
    _ strict: bool,
) -> Verdict {
    if steps.problem() != 0 {
        src.reject_config(INVALID_STEPS)
        trace.verdict = Verdict::Error { code: INVALID_STEPS }
        return trace.verdict
    }
    var model = machine.new_model()
    var sut = machine.new_sut()
    var index: u64 = 0
    var verdict = Verdict::Pass
    while index < steps.max {
        // A failure records no stop flag. Strict replay may end here, but
        // never supply a missing operand or consume an extra saved stop flag.
        if strict && src.unread() == 0 {
            break
        }
        let more = src.draw_weighted(steps.mean, continue_odds(steps.mean))
        if strict && src.clamped() != 0 && trace.repaired_step == NO_STEP {
            trace.repaired_step = index
        }
        if !more { break }
        let cmd = machine.gen_cmd(mut src, model)
        if strict {
            trace.command_end = src.len()
            if (src.clamped() != 0 || src.past_end() != 0) && trace.repaired_step == NO_STEP {
                trace.repaired_step = index
            }
        }
        if src.overran() || src.problem() != 0 {
            break
        }
        if !machine.precondition(model, cmd) {
            trace.skipped += 1
            if record {
                trace
                    .steps
                    .push(
                        Step {
                            index,
                            command: format!(cmd),
                            skipped: true,
                            expected: MemBuffer::new(0),
                            actual: MemBuffer::new(0),
                            verdict: Verdict::Pass,
                        },
                    )
            }
            index += 1
            continue
        }
        let expected = machine.run_model(mut model, cmd)
        let actual = machine.run_sut(mut sut, cmd)
        trace.executed += 1
        // The invariant is checked first because it names the property that
        // broke; a bare result mismatch is reported only when it holds.
        var step_verdict = machine.invariant(model, sut)
        if step_verdict.is_pass() && expected != actual {
            step_verdict = Verdict::Fail { code: POSTCONDITION_MISMATCH }
        }
        if record {
            trace
                .steps
                .push(
                    Step {
                        index,
                        command: format!(cmd),
                        skipped: false,
                        expected: format!(expected),
                        actual: format!(actual),
                        verdict: step_verdict,
                    },
                )
        }
        if !step_verdict.is_pass() {
            verdict = step_verdict
            trace.failed_step = index
            if record {
                machine.describe_failure(step_verdict.code(), mut trace.explanation)
            }
            break
        }
        index += 1
    }
    if src.overran() {
        verdict = Verdict::Discard
    }
    if src.problem() != 0 {
        verdict = Verdict::Error { code: src.problem() }
    }
    trace.verdict = verdict
    verdict
}

/// A state machine whose system under test needs an effect, such as a
/// contract deployed in the `fe test` EVM (`type Env = Evm`).
///
/// It is `StateMachine` with three methods that run with `env`: creating the
/// SUT, applying a command to it, and checking the invariant (which may need
/// to query the SUT). The model side stays pure. Run it with
/// `run_steps_with` or `run_traced_with` from a test that has the effect in
/// scope, usually inside a `check` closure:
///
/// ```fe
/// #[test]
/// fn registry() uses (evm: mut Evm) {
///     let r = check(|src: mut Source| run_steps_with(RegistryMachine {}, mut src, steps(20, 8)),
///                   Config::new(seed: 1, cases: 200))
///     assert!(r.passed())
/// }
/// ```
///
/// Fe 26.6.0 rejects a generic impl with bounds on its parameters for a trait
/// like this one (error 6-0009, fixed upstream in 26.7.0 by
/// https://github.com/argotorg/fe/pull/2000), so pure machines
/// keep their own trait instead of an adapter over this one.
pub trait EffectfulMachine {
    type Cmd: Copy + Display
    type Obs: Copy + Eq + Display
    type Model
    type Sut
    /// The effect the SUT runs with, such as `std::evm::Evm`.
    type Env

    fn new_model(self) -> Self::Model
    fn new_sut(self) -> Self::Sut uses (env: mut Self::Env)
    fn gen_cmd(self, _ src: mut Source, _ model: Self::Model) -> Self::Cmd
    fn precondition(self, _ model: Self::Model, _ cmd: Self::Cmd) -> bool
    fn run_model(self, _ model: mut Self::Model, _ cmd: Self::Cmd) -> Self::Obs
    fn run_sut(self, _ sut: mut Self::Sut, _ cmd: Self::Cmd) -> Self::Obs
    uses (env: mut Self::Env)
    fn invariant(self, _ model: Self::Model, _ sut: Self::Sut) -> Verdict
    uses (env: mut Self::Env)
    fn describe_failure(self, _ code: u64, _ out: mut MemBuffer)
}

/// `run_steps` for an `EffectfulMachine`.
pub fn run_steps_with<M: EffectfulMachine>(
    _ machine: M,
    _ src: mut Source,
    _ steps: Steps,
) -> Verdict
uses (env: mut M::Env)
{
    var trace = Trace::new()
    execute_with(machine, mut src, steps, mut trace, false, false)
}

/// `run_traced` for an `EffectfulMachine`.
pub fn run_traced_with<M: EffectfulMachine>(
    _ machine: M,
    _ src: mut Source,
    _ steps: Steps,
) -> Trace
uses (env: mut M::Env)
{
    var trace = Trace::new()
    let _ = execute_with(machine, mut src, steps, mut trace, true, false)
    trace
}

pub fn trace_recording_with<M: EffectfulMachine>(
    _ machine: M,
    _ src: mut Source,
    _ steps: Steps,
) -> Trace
uses (env: mut M::Env)
{
    var trace = Trace::new()
    let _ = execute_with(machine, mut src, steps, mut trace, true, true)
    trace
}

// Same loop as `execute`, with the SUT calls running under `env`. Kept as a
// copy rather than an adapter because of the 26.6.0 limit noted above; the
// two must stay in step (tests_machine checks they agree on a pure machine).
fn execute_with<M: EffectfulMachine>(
    _ machine: M,
    _ src: mut Source,
    _ steps: Steps,
    _ trace: mut Trace,
    _ record: bool,
    _ strict: bool,
) -> Verdict
uses (env: mut M::Env)
{
    if steps.problem() != 0 {
        src.reject_config(INVALID_STEPS)
        trace.verdict = Verdict::Error { code: INVALID_STEPS }
        return trace.verdict
    }
    var model = machine.new_model()
    var sut = machine.new_sut()
    var index: u64 = 0
    var verdict = Verdict::Pass
    while index < steps.max {
        // A failure records no stop flag. Strict replay may end here, but
        // never supply a missing operand or consume an extra saved stop flag.
        if strict && src.unread() == 0 {
            break
        }
        let more = src.draw_weighted(steps.mean, continue_odds(steps.mean))
        if strict && src.clamped() != 0 && trace.repaired_step == NO_STEP {
            trace.repaired_step = index
        }
        if !more { break }
        let cmd = machine.gen_cmd(mut src, model)
        if strict {
            trace.command_end = src.len()
            if (src.clamped() != 0 || src.past_end() != 0) && trace.repaired_step == NO_STEP {
                trace.repaired_step = index
            }
        }
        if src.overran() || src.problem() != 0 {
            break
        }
        if !machine.precondition(model, cmd) {
            trace.skipped += 1
            if record {
                trace
                    .steps
                    .push(
                        Step {
                            index,
                            command: format!(cmd),
                            skipped: true,
                            expected: MemBuffer::new(0),
                            actual: MemBuffer::new(0),
                            verdict: Verdict::Pass,
                        },
                    )
            }
            index += 1
            continue
        }
        let expected = machine.run_model(mut model, cmd)
        let actual = machine.run_sut(mut sut, cmd)
        trace.executed += 1
        var step_verdict = machine.invariant(model, sut)
        if step_verdict.is_pass() && expected != actual {
            step_verdict = Verdict::Fail { code: POSTCONDITION_MISMATCH }
        }
        if record {
            trace
                .steps
                .push(
                    Step {
                        index,
                        command: format!(cmd),
                        skipped: false,
                        expected: format!(expected),
                        actual: format!(actual),
                        verdict: step_verdict,
                    },
                )
        }
        if !step_verdict.is_pass() {
            verdict = step_verdict
            trace.failed_step = index
            if record {
                machine.describe_failure(step_verdict.code(), mut trace.explanation)
            }
            break
        }
        index += 1
    }
    if src.overran() {
        verdict = Verdict::Discard
    }
    if src.problem() != 0 {
        verdict = Verdict::Error { code: src.problem() }
    }
    trace.verdict = verdict
    verdict
}
