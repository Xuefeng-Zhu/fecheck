// Tests for state machines, case files and replay.

use core::{MemBuffer, MemVec}
use core::abi::DynString
use std::io::Display
use ingot::source::{Source, copy_choices, choices_from, same_choices}
use ingot::verdict::Verdict
use ingot::gen::{Gen, uint_in}
use ingot::runner::{Config, check}
use ingot::machine::{
    StateMachine,
    EffectfulMachine,
    Steps,
    steps,
    run_steps,
    run_traced,
    run_steps_with,
    run_traced_with,
    NO_STEP,
    POSTCONDITION_MISMATCH,
    MAX_STEPS,
    STEPS_NONE,
    STEPS_TOO_MANY,
}
use ingot::artifact::{Case, ParseError, encode, decode, parse_u64}
use ingot::replay::{ReplayOutcome, replay_machine, replay_property, machine_case, case_steps}

// A counter whose `Add` loses one unit when n > 50.
enum CounterCmd {
    Inc,
    Add { pub n: u64 },
}
impl Copy for CounterCmd {}
impl Display for CounterCmd {
    fn fmt(self, _ out: mut MemBuffer) {
        match self {
            CounterCmd::Inc => write!(mut out, "Inc"),
            CounterCmd::Add { n } => write!(mut out, "Add(", n, ")"),
        }
    }
}

struct Counter {
    buggy: bool,
    // When set, the precondition rejects every command.
    reject_all: bool,
}
impl Copy for Counter {}

fn buggy() -> Counter {
    Counter { buggy: true, reject_all: false }
}
fn correct() -> Counter {
    Counter { buggy: false, reject_all: false }
}

/// The SUT records how many commands it has seen, to check fresh starts.
struct CounterSut { value: u64, applied: u64 }

impl StateMachine for Counter {
    type Cmd = CounterCmd
    type Obs = u64
    type Model = u64
    type Sut = CounterSut

    fn new_model(self) -> u64 {
        0
    }
    fn new_sut(self) -> CounterSut {
        CounterSut { value: 0, applied: 0 }
    }
    fn gen_cmd(self, _ src: mut Source, _ model: u64) -> CounterCmd {
        if src.draw_bool() {
            CounterCmd::Add { n: uint_in(0, 100).generate(mut src) }
        } else {
            CounterCmd::Inc
        }
    }
    fn precondition(self, _ model: u64, _ cmd: CounterCmd) -> bool {
        !self.reject_all
    }
    fn run_model(self, _ model: mut u64, _ cmd: CounterCmd) -> u64 {
        match cmd {
            CounterCmd::Inc => {
                model += 1
            },
            CounterCmd::Add { n } => {
                model += n
            },
        }
        model
    }
    fn run_sut(self, _ sut: mut CounterSut, _ cmd: CounterCmd) -> u64 {
        sut.applied += 1
        match cmd {
            CounterCmd::Inc => {
                sut.value += 1
            },
            CounterCmd::Add { n } => {
                if self.buggy && n > 50 {
                    sut.value += n - 1
                } else {
                    sut.value += n
                }
            },
        }
        sut.value
    }
    fn invariant(self, _ model: u64, _ sut: CounterSut) -> Verdict {
        // Never more than one SUT application per model step: catches a SUT
        // that was not reset between runs.
        if sut.applied > 1000 {
            Verdict::Fail { code: 77 }
        } else {
            Verdict::Pass
        }
    }
    fn describe_failure(self, _ code: u64, _ out: mut MemBuffer) {
        write!(mut out, "counter diverged")
    }
}

fn found_case(_ machine: Counter) -> Case {
    let report = check(
        |src: mut Source| run_steps(buggy(), mut src, steps(30, 8)),
        Config::new(seed: 1, cases: 200),
    )
    var src = Source::replay(copy_choices(report.shrunk), 4096)
    let trace = run_traced(buggy(), mut src, steps(30, 8))
    machine_case(
        test: format!("counter"),
        target: format!("buggy"),
        compiler: format!("fe 26.6.0"),
        seed: 1,
        case_index: report.failing_case,
        cases: 200,
        steps: steps(30, 8),
        original_length: 9,
        report.shrunk,
        trace,
    )
}

fn parse(_ text: MemBuffer) -> Case {
    match decode(text.span()) {
        Result::Ok(c) => c,
        Result::Err(_) => panic(),
    }
}

fn rejects(_ text: MemBuffer) -> bool {
    match decode(text.span()) {
        Result::Ok(_) => false,
        Result::Err(_) => true,
    }
}

fn parse_fails(_ text: DynString) -> bool {
    let buf = format!(text)
    match decode(buf.span()) {
        Result::Ok(_) => false,
        Result::Err(_) => true,
    }
}

// ---------------------------------------------------------------- machines

#[test]
fn machine_finds_and_shrinks() {
    let report = check(
        |src: mut Source| run_steps(buggy(), mut src, steps(30, 8)),
        Config::new(seed: 1, cases: 100),
    )
    assert!(report.failed())
    assert!(report.shrunk_verdict.code() == POSTCONDITION_MISMATCH)
    var src = Source::replay(copy_choices(report.shrunk), 4096)
    let trace = run_traced(buggy(), mut src, steps(30, 8))
    assert!(trace.len() == 1)
    assert!(trace.failed_step == 0)
    assert!(trace.steps[0].command == "Add(51)")
    assert!(trace.steps[0].expected == "51")
    assert!(trace.steps[0].actual == "50")
}

#[test]
fn commands_apply_in_order() {
    // more, Inc, more, Add(10), more, Inc, stop
    var src = Source::replay(choices_from([1, 0, 1, 1, 10, 1, 0, 0]), 64)
    let trace = run_traced(correct(), mut src, steps(30, 8))
    assert!(trace.len() == 3)
    assert!(trace.steps[0].command == "Inc")
    assert!(trace.steps[1].command == "Add(10)")
    assert!(trace.steps[2].command == "Inc")
    assert!(trace.steps[0].actual == "1")
    assert!(trace.steps[1].actual == "11")
    assert!(trace.steps[2].actual == "12")
    assert!(trace.verdict.is_pass())
    assert!(trace.failed_step == NO_STEP)
}

#[test]
fn every_run_starts_fresh() {
    // Thousands of commands across cases, but each run starts from new_sut:
    // the `applied > 1000` invariant can only trip if state leaked.
    let report = check(
        |src: mut Source| run_steps(correct(), mut src, steps(50, 30)),
        Config::new(seed: 3, cases: 300),
    )
    assert!(report.passed())
}

#[test]
fn max_steps_is_respected() {
    var src = Source::random(5, 4096)
    let trace = run_traced(correct(), mut src, steps(7, 1000))
    assert!(trace.len() <= 7)
}

#[test]
fn rejected_commands_are_skipped_consistently() {
    let machine = Counter { buggy: true, reject_all: true }
    let report = check(
        |src: mut Source| run_steps(machine, mut src, steps(30, 8)),
        Config::new(seed: 1, cases: 200),
    )
    assert!(report.passed())
    var src = Source::replay(choices_from([1, 1, 99, 1, 0, 0]), 64)
    let trace = run_traced(machine, mut src, steps(30, 8))
    assert!(trace.len() == 2)
    assert!(trace.skipped == 2)
    assert!(trace.executed == 0)
    assert!(trace.steps[0].skipped)
}

// ---------------------------------------------------------------- case files

#[test]
fn case_round_trips() {
    let case = found_case(buggy())
    let text = encode(case)
    let back = parse(text)
    assert!(back.test == "counter")
    assert!(back.target == "buggy")
    assert!(back.compiler == "fe 26.6.0")
    assert!(back.seed == 1)
    assert!(back.original_length == 9)
    assert!(back.verdict.same_failure(case.verdict))
    assert!(
        back.has_failed_step && back.failed_step == case.failed_step,
    )
    assert!(same_choices(back.choices, case.choices))
    assert!(back.ops.len() == case.ops.len())
    assert!(back.ops[0] == case.ops[0])
    assert!(back.violation == "counter diverged")
    // Encoding is stable.
    assert!(encode(back) == text)
}

#[test]
fn malformed_cases_are_rejected() {
    assert!(parse_fails(""))
    assert!(parse_fails("hello world\n"))
    // Unsupported schema versions.
    assert!(parse_fails("fecheck-case 0\n"))
    assert!(parse_fails("fecheck-case 3\n"))
    // Truncated: header only.
    assert!(parse_fails("fecheck-case 1\ntest t\n"))
    // Out-of-order keys.
    assert!(parse_fails("fecheck-case 1\ntarget x\ntest t\n"))
    // Not a number / overflow.
    assert!(
        parse_fails(
            "fecheck-case 1\ntest t\ntarget x\ncompiler c\nfecheck 0.1.0\nseed abc\n",
        ),
    )
    assert!(
        parse_fails(
            "fecheck-case 1\ntest t\ntarget x\ncompiler c\nfecheck 0.1.0\nseed 18446744073709551616\n",
        ),
    )
    // Bad verdict.
    assert!(
        parse_fails(
            "fecheck-case 1\ntest t\ntarget x\ncompiler c\nfecheck 0.1.0\nseed 1\ncase 0\ncases 1\nverdict boom 1\n",
        ),
    )
    // Negative or junk choices.
    assert!(
        parse_fails(
            "fecheck-case 1\ntest t\ntarget x\ncompiler c\nfecheck 0.1.0\nseed 1\ncase 0\ncases 1\nverdict fail 1\nfailed-step 0\noriginal-length 1\nchoices 1 -2\nviolation v\nend\n",
        ),
    )
    // Data after `end`.
    assert!(
        parse_fails(
            "fecheck-case 1\ntest t\ntarget x\ncompiler c\nfecheck 0.1.0\nseed 1\ncase 0\ncases 1\nverdict fail 1\nfailed-step 0\noriginal-length 1\nchoices 1\nviolation v\nend\nextra\n",
        ),
    )
    // A minimal valid file, for contrast.
    assert!(
        !parse_fails(
            "fecheck-case 1\ntest t\ntarget x\ncompiler c\nfecheck 0.1.0\nseed 1\ncase 0\ncases 1\nverdict fail 1\nfailed-step none\noriginal-length 1\nchoices\nviolation v\nend\n",
        ),
    )
    assert!(
        !parse_fails(
            "fecheck-case 2\ntest t\ntarget x\ncompiler c\nfecheck 0.2.0\nseed 1\ncase 0\ncases 1\nsteps 40 12\nverdict fail 1\nfailed-step none\noriginal-length 1\nchoices\nviolation v\nend\n",
        ),
    )
}

#[test]
fn schema_error_reports_version() {
    let text = format!("fecheck-case 7\n")
    match decode(text.span()) {
        Result::Err(ParseError::UnsupportedSchema { found }) => assert!(found == 7),
        _ => assert!(false),
    }
}

#[test]
fn too_many_choices_are_rejected() {
    var text = format!(
        "fecheck-case 1\ntest t\ntarget x\ncompiler c\nfecheck 0.1.0\nseed 1\ncase 0\ncases 1\nverdict fail 1\nfailed-step 0\noriginal-length 1\nchoices",
    )
    var i: u64 = 0
    while i < 4100 {
        write!(mut text, " 1")
        i += 1
    }
    write!(mut text, "\nviolation v\nend\n")
    match decode(text.span()) {
        Result::Err(ParseError::TooManyChoices) => {},
        _ => assert!(false),
    }
}

#[test]
fn parse_u64_edges() {
    let max = format!("18446744073709551615")
    assert!(parse_u64(max.span()) == Option::Some(0xFFFFFFFFFFFFFFFF))
    let over = format!("18446744073709551616")
    assert!(parse_u64(over.span()) == Option::None)
    let empty = format!("")
    assert!(parse_u64(empty.span()) == Option::None)
    let plus = format!("+1")
    assert!(parse_u64(plus.span()) == Option::None)
}

// ---------------------------------------------------------------- replay

#[test]
fn replay_reproduces_saved_failure() {
    let case = parse(encode(found_case(buggy())))
    let (outcome, trace) = replay_machine(buggy(), steps(30, 8), case)
    assert!(outcome.is_reproduced())
    assert!(trace.failed_step == case.failed_step)
}

#[test]
fn replay_against_fix_no_longer_fails() {
    let case = parse(encode(found_case(buggy())))
    let (outcome, trace) = replay_machine(correct(), steps(30, 8), case)
    assert!(outcome.kind() == 1)
    // The same operations ran; they just passed.
    assert!(trace.steps.len() == case.ops.len())
}

#[test]
fn replay_detects_drift() {
    var case = parse(encode(found_case(buggy())))
    case.ops[0] = format!("Inc")
    let (outcome, _) = replay_machine(buggy(), steps(30, 8), case)
    assert!(outcome.kind() == 4)
}

#[test]
fn replay_detects_a_different_failure() {
    var case = parse(encode(found_case(buggy())))
    // Pretend the recorded failure was an invariant violation instead.
    case.verdict = Verdict::Fail { code: 77 }
    let (outcome, _) = replay_machine(buggy(), steps(30, 8), case)
    assert!(outcome.kind() == 2)
    assert!(!outcome.is_reproduced())
}

#[test]
fn replay_never_reads_an_error_as_success() {
    var case = parse(encode(found_case(buggy())))
    // A property that errors on these choices must not count as reproduced
    // a recorded *failure*, nor as fixed.
    let outcome = replay_property(
        |src: mut Source| {
            let _ = src.draw(10)
            Verdict::Error { code: POSTCONDITION_MISMATCH }
        },
        case,
    )
    assert!(outcome.kind() == 2)
}

#[test]
fn replay_property_round_trip() {
    let test = |src: mut Source| {
        let x = uint_in(0, 1000000).generate(mut src)
        if x >= 1234 {
            Verdict::Fail { code: 5 }
        } else {
            Verdict::Pass
        }
    }
    let report = check(test, Config::new(seed: 3, cases: 100))
    var case = parse(encode(found_case(buggy())))
    case.choices = copy_choices(report.shrunk)
    case.verdict = report.shrunk_verdict
    case.has_failed_step = false
    let outcome = replay_property(test, case)
    assert!(outcome.is_reproduced())
}

// ---------------------------------------------------------------- 0.2.0 regressions

/// A buggy-counter case found with `s`, without shrinking, so it keeps the
/// full length of the first failing run.
fn unshrunk_case(_ s: Steps, _ seed: u64) -> Case {
    var config = Config::new(seed, cases: 2000)
    config.shrink_budget = 0
    let report = check(|src: mut Source| run_steps(buggy(), mut src, s), config)
    assert!(report.failed())
    var src = Source::replay(copy_choices(report.shrunk), 4096)
    let trace = run_traced(buggy(), mut src, s)
    machine_case(
        test: format!("counter"),
        target: format!("buggy"),
        compiler: format!("fe 26.6.0"),
        seed,
        case_index: report.failing_case,
        cases: 2000,
        steps: s,
        original_length: trace.len(),
        report.shrunk,
        trace,
    )
}

/// A long failing run (more operations than the caller's fallback allows)
/// replays with the settings it was found with. Before 0.2.0 the CLI
/// replayed every case with 40 operations and reported drift.
#[test]
fn replay_uses_recorded_steps_for_long_cases() {
    // 45 `Inc`s, then an `Add(60)` that the buggy counter gets wrong: a
    // 46-operation failure, like the 41-operation queue case found with
    // `--steps 80`.
    var choices: MemVec<u64> = MemVec::new()
    var i: u64 = 0
    while i < 45 {
        choices.push(1)
        choices.push(0)
        i += 1
    }
    choices.push(1)
    choices.push(1)
    choices.push(60)
    let s = steps(200, 60)
    var src = Source::replay(copy_choices(choices), 4096)
    let trace = run_traced(buggy(), mut src, s)
    assert!(trace.len() == 46 && trace.failed_step == 45)
    let case = machine_case(
        test: format!("counter"),
        target: format!("buggy"),
        compiler: format!("fe 26.6.0"),
        seed: 0,
        case_index: 0,
        cases: 1,
        steps: s,
        original_length: 46,
        choices,
        trace,
    )
    let parsed = parse(encode(case))
    assert!(
        parsed.has_steps && parsed.steps_max == 200 && parsed.steps_mean == 60,
    )
    // The fallback (40, 12) is ignored because the case recorded its own.
    let (outcome, trace) = replay_machine(buggy(), steps(40, 12), parsed)
    assert!(outcome.is_reproduced())
    assert!(trace.steps.len() == parsed.ops.len())
    assert!(case_steps(parsed).max == 200)
    // With only the 0.1.0 settings it cannot be replayed: drift.
    var legacy = parse(encode(case))
    legacy.has_steps = false
    let (old_outcome, _) = replay_machine(buggy(), steps(40, 12), legacy)
    assert!(old_outcome.kind() == 4)
}

/// A case file missing its final operation must not reproduce.
#[test]
fn replay_rejects_a_case_missing_its_last_op() {
    let case = parse(encode(unshrunk_case(steps(30, 8), 1)))
    assert!(case.ops.len() >= 1)
    let text = encode(case)
    // Rebuild the file without the last `op` line.
    var cut = parse(text)
    let full_len = cut.ops.len()
    var ops: MemVec<MemBuffer> = MemVec::new()
    var i: usize = 0
    while i + 1 < full_len {
        ops.push(format!(cut.ops[i]))
        i += 1
    }
    cut.ops = ops
    // The failing op is the last one, so the cut file names a failed step
    // with no `op` line: the parser rejects it as inconsistent.
    assert!(rejects(encode(cut)))
    // An extra, unrecorded trailing choice is drift too.
    var longer = parse(text)
    longer.choices.push(1)
    longer.choices.push(1)
    let (outcome2, _) = replay_machine(buggy(), steps(30, 8), longer)
    assert!(!outcome2.is_reproduced())
}

/// Schema-1 files from FeCheck 0.1.0 still parse and replay.
#[test]
fn schema_1_files_still_replay() {
    let case = found_case(buggy())
    // Write the 0.1.0 format by hand: header 1, no `steps` line.
    var text = format!(
        "fecheck-case 1\ntest counter\ntarget buggy\ncompiler fe 26.6.0\nfecheck 0.1.0\nseed 1\ncase 0\ncases 200\n",
    )
    write!(mut text, "verdict fail ", case.verdict.code(), "\n")
    write!(mut text, "failed-step ", case.failed_step, "\n")
    write!(mut text, "original-length 9\nchoices")
    for c in case.choices {
        write!(mut text, " ", c)
    }
    write!(mut text, "\n")
    for ref op in case.ops {
        write!(mut text, "op ", op, "\n")
    }
    write!(mut text, "violation counter diverged\nend\n")
    let old = parse(text)
    assert!(old.schema == 1)
    assert!(!old.has_steps)
    assert!(case_steps(old).max == 40 && case_steps(old).mean == 12)
    // A legacy file replays with the caller's settings.
    let (outcome, _) = replay_machine(buggy(), steps(30, 8), old)
    assert!(outcome.is_reproduced())
    let saved = parse(encode(old))
    assert!(
        saved.schema == 1 && !saved.has_steps && saved.producer == "0.1.0",
    )
    // A schema-2 file without its `steps` line is rejected.
    assert!(
        parse_fails(
            "fecheck-case 2\ntest t\ntarget x\ncompiler c\nfecheck 0.2.0\nseed 1\ncase 0\ncases 1\nverdict fail 1\nfailed-step 0\noriginal-length 1\nchoices 1\nop Inc\nviolation v\nend\n",
        ),
    )
    assert!(
        parse_fails(
            "fecheck-case 2\ntest t\ntarget x\ncompiler c\nfecheck 0.2.0\nseed 1\ncase 0\ncases 1\nsteps 40\nverdict fail 1\nfailed-step none\noriginal-length 1\nchoices\nviolation v\nend\n",
        ),
    )
}

/// Zero-length runs are rejected instead of passing vacuously.
#[test]
fn steps_settings_are_validated() {
    assert!(steps(0, 12).problem() == STEPS_NONE)
    assert!(steps(MAX_STEPS + 1, 12).problem() == STEPS_TOO_MANY)
    assert!(steps(1, 1).problem() == 0)
    assert!(steps(MAX_STEPS, 12).problem() == 0)
}

// The same counter as an EffectfulMachine: its value lives in an effect,
// the way a deployed contract's state lives in the EVM.
struct Ledger { value: u64, sut_calls: u64, resets: u64 }

struct EffCounter { buggy: bool }
impl Copy for EffCounter {}

impl EffectfulMachine for EffCounter {
    type Cmd = CounterCmd
    type Obs = u64
    type Model = u64
    type Sut = u64
    type Env = Ledger

    fn new_model(self) -> u64 {
        0
    }
    fn new_sut(self) -> u64 uses (env: mut Ledger) {
        env.value = 0
        env.resets += 1
        env.resets
    }
    fn gen_cmd(self, _ src: mut Source, _ model: u64) -> CounterCmd {
        if src.draw_bool() {
            CounterCmd::Add { n: uint_in(0, 100).generate(mut src) }
        } else {
            CounterCmd::Inc
        }
    }
    fn precondition(self, _ model: u64, _ cmd: CounterCmd) -> bool {
        true
    }
    fn run_model(self, _ model: mut u64, _ cmd: CounterCmd) -> u64 {
        match cmd {
            CounterCmd::Inc => {
                model += 1
            },
            CounterCmd::Add { n } => {
                model += n
            },
        }
        model
    }
    fn run_sut(self, _ sut: mut u64, _ cmd: CounterCmd) -> u64
    uses (env: mut Ledger)
    {
        env.sut_calls += 1
        match cmd {
            CounterCmd::Inc => {
                env.value += 1
            },
            CounterCmd::Add { n } => {
                if self.buggy && n > 50 {
                    env.value += n - 1
                } else {
                    env.value += n
                }
            },
        }
        env.value
    }
    fn invariant(self, _ model: u64, _ sut: u64) -> Verdict uses (env: mut Ledger) {
        // The handle from new_sut must be the current run's.
        if sut != env.resets {
            Verdict::Fail { code: 77 }
        } else {
            Verdict::Pass
        }
    }
    fn describe_failure(self, _ code: u64, _ out: mut MemBuffer) {
        write!(mut out, "counter diverged")
    }
}

#[test]
fn effectful_machine_finds_and_shrinks() {
    var ledger = Ledger { value: 0, sut_calls: 0, resets: 0 }
    let report = with (ledger) {
        check(
            |src: mut Source| run_steps_with(EffCounter { buggy: true }, mut src, steps(30, 8)),
            Config::new(seed: 1, cases: 100),
        )
    }
    assert!(report.failed())
    assert!(report.shrunk_verdict.code() == POSTCONDITION_MISMATCH)
    assert!(ledger.resets > 1)
    var src = Source::replay(copy_choices(report.shrunk), 4096)
    let trace = with (ledger) {
        run_traced_with(EffCounter { buggy: true }, mut src, steps(30, 8))
    }
    assert!(trace.len() == 1)
    assert!(trace.steps[0].command == "Add(51)")
    assert!(trace.steps[0].expected == "51")
    assert!(trace.steps[0].actual == "50")
}

#[test]
fn effectful_and_pure_engines_agree() {
    // Both loops must read the same choices and produce the same trace.
    var ledger = Ledger { value: 0, sut_calls: 0, resets: 0 }
    var seed: u64 = 0
    var executed: u64 = 0
    while seed < 60 {
        var a = Source::random(seed, 4096)
        var b = Source::random(seed, 4096)
        let pure = run_traced(buggy(), mut a, steps(20, 6))
        let calls_before = ledger.sut_calls
        let eff = with (ledger) {
            run_traced_with(EffCounter { buggy: true }, mut b, steps(20, 6))
        }
        assert!(same_choices(a.into_choices(), b.into_choices()))
        assert!(pure.len() == eff.len())
        assert!(pure.executed == eff.executed)
        assert!(pure.failed_step == eff.failed_step)
        assert!(pure.verdict.code() == eff.verdict.code())
        assert!(ledger.sut_calls - calls_before == eff.executed)
        var i: usize = 0
        while i < pure.steps.len() {
            assert!(pure.steps[i].command == eff.steps[i].command)
            assert!(pure.steps[i].expected == eff.steps[i].expected)
            assert!(pure.steps[i].actual == eff.steps[i].actual)
            i += 1
        }
        executed += eff.executed
        seed += 1
    }
    assert!(executed > 0)
    assert!(ledger.resets == 60)
}
