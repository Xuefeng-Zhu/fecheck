use core::{MemBuffer, MemSpan}
use fecheck::{Case, encode}

/// The fixed implementation of the bundled test family, as a Fe expression.
fn fixed_expr(_ target: MemSpan) -> MemBuffer {
    if target.starts_with("permissions") {
        format!("permissions::against_fixed()")
    } else {
        format!("queue::against_mod()")
    }
}

/// Appends Fe statements that append `line` and a newline to `text`.
/// Printable ASCII, tab and carriage return fit in a Fe string literal
/// (`\\`, `\"`, `\t`, `\r`). Fe has no `\x` escape, so a line with any other
/// byte is appended byte by byte instead.
fn write_line_code(_ out: mut MemBuffer, _ line: MemSpan) {
    var literal_ok = true
    for b in line {
        if b != 9 && b != 13 && (b < 32 || b >= 127) {
            literal_ok = false
        }
    }
    if !literal_ok {
        for b in line {
            writeln!(mut out, "      text.push(", b, ")")
        }
        writeln!(mut out, "      text.push(10)")
        return
    }
    var literal = MemBuffer::new(0)
    for b in line {
        if b == b'"' {
            literal.push(92)
            literal.push(b'"')
        } else if b == 92 {
            literal.push(92)
            literal.push(92)
        } else if b == 9 {
            literal.push(92)
            literal.push(b't')
        } else if b == 13 {
            literal.push(92)
            literal.push(b'r')
        } else {
            literal.push(b)
        }
    }
    writeln!(mut out, "      writeln!(mut text, \"", literal, "\")")
}

/// Renders a compilable regression test for the bundled target. It passes
/// against the fixed implementation and fails against the buggy one;
/// `scripts/cli-checks.sh` compiles and runs it both ways.
pub fn regression_text(_ case: Case) -> MemBuffer {
    var out = MemBuffer::new(0)
    let target = case.target.span()
    let family = if target.starts_with("permissions") {
        format!("permissions")
    } else {
        format!("queue")
    }
    writeln!(
        mut out,
        "Regression test (add to a test module of an ingot that depends on fecheck and ",
        family,
        "):",
    )
    writeln!(mut out, "  #[test]")
    writeln!(
        mut out,
        "  fn regression_",
        case.test,
        "_seed_",
        case.seed,
        "() {",
    )
    let text = encode(case)
    writeln!(mut out, "      var text = core::MemBuffer::new(0)")
    for line in text.span().lines() {
        write_line_code(mut out, line)
    }
    writeln!(
        mut out,
        "      let case = match fecheck::decode(text.span()) { Result::Ok(c) => c, Result::Err(_) => panic() }",
    )
    writeln!(
        mut out,
        "      let (outcome, _) = fecheck::replay_machine(",
        fixed_expr(target),
        ", fecheck::case_steps(case), case)",
    )
    writeln!(
        mut out,
        "      assert!(match outcome { fecheck::ReplayOutcome::NoLongerFails => true, _ => false })",
    )
    writeln!(mut out, "  }")
    out
}
