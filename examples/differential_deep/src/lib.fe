// Demo D at depth, for the native backend only: every differential
// property at 100 times its `examples/differential` case count, with a
// different seed. The EVM test runner caps gas per test, so this ingot is
// run with `fe test --backend native` (CI does; see scripts/test.sh).
use fecheck::{Source, Config, check}
use differential::*

fn passes<F: Fn(mut Source) -> fecheck::Verdict>(_ f: F, _ cases: u64) -> bool
uses F::E
{
    check(f, Config::new(seed: 20261124, cases: cases * 100)).passed()
}

#[test]
fn deep_shl_u8_agrees() {
    assert!(passes(|src: mut Source| shl_u8(mut src), 500))
}

#[test]
fn deep_shr_u8_agrees() {
    assert!(passes(|src: mut Source| shr_u8(mut src), 500))
}

