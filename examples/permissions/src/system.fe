// An agent permission system with a decision cache.
//
// Authorising an action is "expensive" (imagine a policy engine or a
// signature check), so the system remembers the last decision it made.
// Two implementations share the `PermissionApi` interface:
//
// * `CachedPermissions` has a realistic defect: `revoke` clears the grant
//   but forgets to invalidate the cached decision, so an agent that executed
//   just before being revoked can keep executing.
// * `FixedPermissions` invalidates the cache on every revoke.
//
// Neither the test nor FeCheck is told which sequence triggers the bug.

pub const AGENTS: u64 = 4

// The registry's logic, written once. `CachedPermissions` below runs it over
// an in-memory array; Demo C's contracts (examples/contract) run the same
// functions over contract storage. Only the grant table differs.

/// Where grants live: an array here, a `StorageMap` in a contract.
pub trait Grants {
    fn is_granted(self, _ agent: u256) -> bool
    fn set_granted(mut self, _ agent: u256, _ value: bool)
}

/// The last authorisation decision.
pub struct Cache { pub valid: bool, pub agent: u256, pub allowed: bool }

impl Copy for Cache {}

impl Cache {
    pub fn empty() -> Self {
        Cache { valid: false, agent: 0, allowed: false }
    }
}

pub fn registry_grant<G: Grants>(_ grants: mut G, _ cache: mut Cache, _ agent: u256) {
    grants.set_granted(agent, true)
    // A new grant can only widen access, so the cache is refreshed.
    cache.valid = false
}

/// BUG: the cached decision for `agent` is left in place.
pub fn registry_revoke_cached<G: Grants>(_ grants: mut G, _ cache: mut Cache, _ agent: u256) {
    grants.set_granted(agent, false)
}

/// FIX: a revoke invalidates the cached decision.
pub fn registry_revoke_fixed<G: Grants>(_ grants: mut G, _ cache: mut Cache, _ agent: u256) {
    grants.set_granted(agent, false)
    cache.valid = false
}

/// Whether `agent` may execute right now.
pub fn registry_execute<G: Grants>(_ grants: G, _ cache: mut Cache, _ agent: u256) -> bool {
    if cache.valid && cache.agent == agent {
        return cache.allowed
    }
    let allowed = grants.is_granted(agent)
    cache.valid = true
    cache.agent = agent
    cache.allowed = allowed
    allowed
}

/// Grants for agents 0 to 3 in an array.
pub struct ArrayGrants { granted: [bool; 4] }

impl Copy for ArrayGrants {}

impl Grants for ArrayGrants {
    fn is_granted(self, _ agent: u256) -> bool {
        let i: usize = agent.downcast_saturate()
        self.granted[i]
    }

    fn set_granted(mut self, _ agent: u256, _ value: bool) {
        let i: usize = agent.downcast_saturate()
        self.granted[i] = value
    }
}

pub trait PermissionApi {
    fn grant(mut self, _ agent: u64)
    fn revoke(mut self, _ agent: u64)
    /// Whether `agent` may execute right now.
    fn execute(mut self, _ agent: u64) -> bool
}

pub struct CachedPermissions { grants: ArrayGrants, cache: Cache }

impl Copy for CachedPermissions {}

impl CachedPermissions {
    pub fn new() -> Self {
        CachedPermissions { grants: ArrayGrants { granted: [false; 4] }, cache: Cache::empty() }
    }
}

impl PermissionApi for CachedPermissions {
    fn grant(mut self, _ agent: u64) {
        registry_grant(mut self.grants, mut self.cache, agent as u256)
    }

    fn revoke(mut self, _ agent: u64) {
        registry_revoke_cached(mut self.grants, mut self.cache, agent as u256)
    }

    fn execute(mut self, _ agent: u64) -> bool {
        registry_execute(self.grants, mut self.cache, agent as u256)
    }
}

pub struct FixedPermissions { grants: ArrayGrants, cache: Cache }

impl Copy for FixedPermissions {}

impl FixedPermissions {
    pub fn new() -> Self {
        FixedPermissions { grants: ArrayGrants { granted: [false; 4] }, cache: Cache::empty() }
    }
}

impl PermissionApi for FixedPermissions {
    fn grant(mut self, _ agent: u64) {
        registry_grant(mut self.grants, mut self.cache, agent as u256)
    }

    fn revoke(mut self, _ agent: u64) {
        registry_revoke_fixed(mut self.grants, mut self.cache, agent as u256)
    }

    fn execute(mut self, _ agent: u64) -> bool {
        registry_execute(self.grants, mut self.cache, agent as u256)
    }
}

/// An agent id as an array index. Agents are always below `AGENTS`.
pub fn idx(_ agent: u64) -> usize {
    agent.downcast_saturate()
}
