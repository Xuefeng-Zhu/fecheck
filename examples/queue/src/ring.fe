// A bounded FIFO queue on a fixed ring buffer, capacity 3.
//
// The ring has 4 slots so that a power-of-two mask *would* work for wrap
// around if all four were used. `MaskedRing` has a classic defect: it wraps
// its write position with `& 3` (assuming capacity 4) but its read position
// with `% 3`, so once the queue wraps, reads and writes disagree about
// where the oldest element lives. `ModRing` wraps both with `% CAPACITY`.

pub const CAPACITY: u64 = 3

pub trait BoundedQueue {
    /// Appends `value`; false when the queue is full.
    fn push(mut self, _ value: u64) -> bool
    /// Removes the oldest value, if any.
    fn pop(mut self) -> Option<u64>
    fn len(self) -> u64
}

pub struct MaskedRing {
    slots: [u64; 4],
    head: u64,
    count: u64,
    tail: u64,
}

impl Copy for MaskedRing {}

impl MaskedRing {
    pub fn new() -> Self {
        MaskedRing { slots: [0; 4], head: 0, count: 0, tail: 0 }
    }
}

impl BoundedQueue for MaskedRing {
    fn push(mut self, _ value: u64) -> bool {
        if self.count == CAPACITY {
            return false
        }
        self.slots[slot(self.tail)] = value
        // BUG: power-of-two wrap for a capacity that is not a power of two.
        self.tail = (self.tail + 1) & 3
        self.count += 1
        true
    }

    fn pop(mut self) -> Option<u64> {
        if self.count == 0 {
            return Option::None
        }
        let value = self.slots[slot(self.head)]
        self.head = (self.head + 1) % CAPACITY
        self.count -= 1
        Option::Some(value)
    }

    fn len(self) -> u64 {
        self.count
    }
}

pub struct ModRing {
    slots: [u64; 4],
    head: u64,
    count: u64,
    tail: u64,
}

impl Copy for ModRing {}

impl ModRing {
    pub fn new() -> Self {
        ModRing { slots: [0; 4], head: 0, count: 0, tail: 0 }
    }
}

impl BoundedQueue for ModRing {
    fn push(mut self, _ value: u64) -> bool {
        if self.count == CAPACITY {
            return false
        }
        self.slots[slot(self.tail)] = value
        self.tail = (self.tail + 1) % CAPACITY
        self.count += 1
        true
    }

    fn pop(mut self) -> Option<u64> {
        if self.count == 0 {
            return Option::None
        }
        let value = self.slots[slot(self.head)]
        self.head = (self.head + 1) % CAPACITY
        self.count -= 1
        Option::Some(value)
    }

    fn len(self) -> u64 {
        self.count
    }
}

fn slot(_ i: u64) -> usize {
    i.downcast_saturate()
}
