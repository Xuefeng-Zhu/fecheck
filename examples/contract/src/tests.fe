use std::evm::Evm
use fecheck::{Source, Verdict, Config, check, copy_choices, run_choices}
use ingot::{CachedRegistry, FixedRegistry, PermissionMsg}

pub const REVOKED_AGENT_EXECUTED: u64 = 1
pub const GRANTED_AGENT_DENIED: u64 = 2

/// One generated command sequence against a freshly deployed `C`.
/// The model is a 4-bit set of granted agents.
fn registry_case<C: std::evm::Contract<InitArgs = ()>>(_ src: mut Source) -> Verdict
uses (evm: mut Evm)
{
    let addr = evm.create<C>(value: Wei::zero(), args: ())
    var granted: [bool; 4] = [false; 4]
    var step: u64 = 0
    while step < 30 {
        if !src.draw_weighted(10, 11) {
            break
        }
        let kind = src.draw(2)
        let agent = src.draw(3)
        let i: usize = agent.downcast_saturate()
        if kind == 0 {
            evm.call(
                addr: addr,
                gas: 200000,
                value: Wei::zero(),
                message: PermissionMsg::Grant { agent: agent as u256 },
            )
            granted[i] = true
        } else if kind == 1 {
            // Precondition: only an existing grant can be revoked.
            if granted[i] {
                evm.call(
                    addr: addr,
                    gas: 200000,
                    value: Wei::zero(),
                    message: PermissionMsg::Revoke { agent: agent as u256 },
                )
                granted[i] = false
            }
        } else {
            let allowed: bool = evm
                .call(
                    addr: addr,
                    gas: 200000,
                    value: Wei::zero(),
                    message: PermissionMsg::Execute { agent: agent as u256 },
                )
            if allowed && !granted[i] {
                return Verdict::Fail { code: REVOKED_AGENT_EXECUTED }
            }
            if !allowed && granted[i] {
                return Verdict::Fail { code: GRANTED_AGENT_DENIED }
            }
        }
        step += 1
    }
    Verdict::Pass
}

#[test]
fn contract_bug_is_found_and_shrunk() uses (evm: mut Evm) {
    let report = check(
        |src: mut Source| registry_case<CachedRegistry>(mut src),
        Config::new(seed: 12345, cases: 300),
    )
    assert!(report.failed())
    assert!(report.shrunk_verdict.code() == REVOKED_AGENT_EXECUTED)
    // Four commands of three choices each (more-flag, kind, agent):
    // Grant(a), Execute(a), Revoke(a), Execute(a).
    assert!(report.shrunk.len() == 12)
    assert!(
        report.shrunk[1] == 0
            && report.shrunk[4] == 2
            && report.shrunk[7] == 1
            && report.shrunk[10] == 2,
    )
    assert!(
        report.shrunk.len() < report.original.len() || report.original.len() == 12,
    )

    // The shrunk case passes against the fixed contract.
    let (verdict, _) = run_choices(
        |src: mut Source| registry_case<FixedRegistry>(mut src),
        report.shrunk,
        4096,
    )
    assert!(verdict.is_pass())
}

#[test]
fn fixed_contract_passes() uses (evm: mut Evm) {
    let report = check(
        |src: mut Source| registry_case<FixedRegistry>(mut src),
        Config::new(seed: 12345, cases: 300),
    )
    assert!(report.passed())
}
