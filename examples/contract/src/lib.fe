// Demo C: state-machine testing of a deployed EVM contract.
//
// The same permission bug as Demo A, but in a real Fe contract deployed into
// the `fe test` EVM. The FeCheck engine runs unchanged: the test closure
// declares `uses (evm: mut Evm)`, and `check` forwards that effect (`uses
// F::E`), so every generated case and every shrink candidate deploys a fresh
// contract and drives it with real message calls.

use std::abi::sol
use std::evm::{Evm, StorageMap}
use permissions::{
    Grants,
    Cache,
    registry_grant,
    registry_revoke_cached,
    registry_revoke_fixed,
    registry_execute,
}

msg PermissionMsg {
    #[selector = sol("grant(uint256)")]
    Grant { agent: u256 },
    #[selector = sol("revoke(uint256)")]
    Revoke { agent: u256 },
    #[selector = sol("execute(uint256)")]
    Execute { agent: u256 } -> bool,
}

/// The grant table in contract storage. The registry logic itself is the
/// same Fe code the native Demo A runs (`permissions::registry_*`).
pub struct GrantTable { map: StorageMap<u256, bool> }

impl Grants for GrantTable {
    fn is_granted(self, _ agent: u256) -> bool {
        self.map.get(key: agent)
    }

    fn set_granted(mut self, _ agent: u256, _ value: bool) {
        self.map.set(key: agent, value: value)
    }
}

/// Remembers the last authorisation decision to save an SLOAD on repeats.
/// BUG: `Revoke` does not clear the cached decision.
pub contract CachedRegistry {
    mut granted: GrantTable,
    mut cache: Cache,

    recv PermissionMsg {
        Grant { agent } uses (mut granted, mut cache) {
            registry_grant(mut granted, mut cache, agent)
        }

        Revoke { agent } uses (mut granted, mut cache) {
            registry_revoke_cached(mut granted, mut cache, agent)
        }

        Execute { agent } -> bool uses (granted, mut cache) {
            registry_execute(granted, mut cache, agent)
        }
    }
}

/// The same registry with the cache invalidated on revoke.
pub contract FixedRegistry {
    mut granted: GrantTable,
    mut cache: Cache,

    recv PermissionMsg {
        Grant { agent } uses (mut granted, mut cache) {
            registry_grant(mut granted, mut cache, agent)
        }

        Revoke { agent } uses (mut granted, mut cache) {
            registry_revoke_fixed(mut granted, mut cache, agent)
        }

        Execute { agent } -> bool uses (granted, mut cache) {
            registry_execute(granted, mut cache, agent)
        }
    }
}
