use fecheck::{Source, Config, check}
use ingot::*

fn passes<F: Fn(mut Source) -> fecheck::Verdict>(_ f: F, _ cases: u64) -> bool
uses F::E
{
    check(f, Config::new(seed: 1, cases: cases * 10)).passed()
}

#[test]
fn shl_u8_agrees() {
    assert!(passes(|src: mut Source| shl_u8(mut src), 500))
}

#[test]
fn shr_u8_agrees() {
    assert!(passes(|src: mut Source| shr_u8(mut src), 500))
}

